# =============================================================================
# Varsha — Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# --- Database ---
POSTGRES_USER=varsha
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=varsha
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Docker sets DATABASE_URL itself (see docker-compose.yml). For local runs without
# Docker, leave DATABASE_URL unset to use SQLite at data/varsha.db, or point it at
# your own PostGIS: postgresql+asyncpg://varsha:changeme_in_production@localhost:5432/varsha
# DATABASE_URL=

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=generate-a-random-secret-key-here
DEBUG=true
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPLIBRE_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# --- Data Sources (most are open, some need registration) ---
# CHIRPS: open, no key needed
CHIRPS_BASE_URL=https://data.chc.ucsb.edu/products/CHIRPS-2.0

# ERA5: requires CDS API key (register at https://cds.climate.copernicus.eu/)
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
CDS_API_KEY=

# NOAA ENSO/MJO: open
NOAA_CPC_URL=https://www.cpc.ncep.noaa.gov

# IMD: may require institutional access
IMD_DATA_PATH=./data/cache/imd

# --- Translation ---
# Bhashini API (register at https://bhashini.gov.in/ulca)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# --- Messaging (mock by default) ---
MESSAGING_MODE=mock
# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Generic HTTP SMS gateway (optional; e.g. a DLT-registered Indian provider)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=VARSHA

# --- Data ---
# 1 = never call NOAA / BoM (use synthetic drivers)
VARSHA_OFFLINE=0

# --- Officer Auth (simple for prototype) ---
OFFICER_USERNAME=officer
OFFICER_PASSWORD=varsha2024
